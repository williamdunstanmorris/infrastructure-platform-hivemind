apiVersion: v1
clusters:
- cluster:
    certificate-authority-data: 
    server: https://localhost:8443
    tls-server-name: 48A42C1A8C0BBFF7E92C5A677B8DE59A.gr7.eu-central-1.eks.amazonaws.com
  name: arn:aws:eks:eu-central-1:435957166704:cluster/Main
contexts:
- context:
    cluster: arn:aws:eks:eu-central-1:435957166704:cluster/Main
    user: arn:aws:eks:eu-central-1:435957166704:cluster/Main
  name: arn:aws:eks:eu-central-1:435957166704:cluster/Main
current-context: arn:aws:eks:eu-central-1:435957166704:cluster/Main
kind: Config
users:
- name: arn:aws:eks:eu-central-1:435957166704:cluster/Main
  user:
    exec:
      apiVersion: client.authentication.k8s.io/v1beta1
      args:
      - --region
      - eu-central-1
      - eks
      - get-token
      - --cluster-name
      - Main
      - --output
      - json
      command: aws
      env:
      - name: AWS_PROFILE
        value: hivemind
      interactiveMode: IfAvailable
      provideClusterInfo: false
